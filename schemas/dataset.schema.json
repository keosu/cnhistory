{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cngeojson:dataset:1.0.0",
  "title": "Toolbay historical atlas normalized records",
  "description": "Reference a definition with #/$defs/entity, period, ruler, era, event, tile, or territoryFeature. Source anomalies are deliberately not rejected by chronological constraints.",
  "$defs": {
    "names": {
      "type": "object", "required": ["ja", "en", "zh"],
      "properties": {"ja": {"type": ["string", "null"]}, "en": {"type": ["string", "null"]}, "zh": {"type": ["string", "null"]}},
      "additionalProperties": false
    },
    "point": {"type": "array", "prefixItems": [{"type": "number", "minimum": -180, "maximum": 180}, {"type": "number", "minimum": -90, "maximum": 90}], "minItems": 2, "maxItems": 2},
    "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "source": {
      "type": "object", "required": ["file"],
      "properties": {"file": {"type": "string"}, "region_index": {"type": "integer", "minimum": 0}, "row_index": {"type": "integer", "minimum": 0}, "variable": {"type": "string"}, "lane_index": {"type": "integer", "minimum": 0}, "x": {"type": "integer"}, "y": {"type": "integer"}, "image": {"type": "string"}}
    },
    "interval": {
      "type": "object", "required": ["start_year", "end_year", "open_ended"],
      "properties": {"start_year": {"type": "integer"}, "end_year": {"type": "integer"}, "open_ended": {"type": "boolean"}}
    },
    "period": {
      "allOf": [{"$ref": "#/$defs/interval"}],
      "type": "object", "required": ["id", "entity_id", "names", "abbreviations", "label_position", "source"],
      "properties": {"id": {"type": "string"}, "entity_id": {"type": "string"}, "names": {"$ref": "#/$defs/names"}, "abbreviations": {"anyOf": [{"$ref": "#/$defs/names"}, {"type": "null"}]}, "symbol_key": {"type": ["string", "null"]}, "label_position": {"anyOf": [{"$ref": "#/$defs/point"}, {"type": "null"}]}, "source_pixel": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 2, "maxItems": 2}, "display_level": {"type": ["number", "null"]}, "source": {"$ref": "#/$defs/source"}}
    },
    "entity": {
      "allOf": [{"$ref": "#/$defs/interval"}],
      "type": "object", "required": ["id", "periods", "in_focus", "source"],
      "properties": {"id": {"type": "string"}, "periods": {"type": "array", "items": {"$ref": "#/$defs/period"}}, "in_focus": {"type": "boolean"}, "source": {"$ref": "#/$defs/source"}}
    },
    "ruler": {
      "allOf": [{"$ref": "#/$defs/interval"}],
      "type": "object", "required": ["id", "entity_id", "names", "role", "source"],
      "properties": {"id": {"type": "string"}, "entity_id": {"type": "string"}, "names": {"$ref": "#/$defs/names"}, "role": {"anyOf": [{"$ref": "#/$defs/names"}, {"type": "null"}]}, "portrait_key": {"type": ["string", "null"]}, "source": {"$ref": "#/$defs/source"}}
    },
    "era": {
      "allOf": [{"$ref": "#/$defs/interval"}],
      "type": "object", "required": ["id", "country", "lane", "name", "source"],
      "properties": {"id": {"type": "string"}, "country": {"enum": ["cn", "jp"]}, "lane": {"type": "integer", "minimum": 0}, "name": {"type": "string"}, "source": {"$ref": "#/$defs/source"}}
    },
    "event": {
      "type": "object", "required": ["id", "kind", "year", "title", "entity_id", "record_id", "derived", "source"],
      "properties": {"id": {"type": "string"}, "kind": {"enum": ["polity_start", "polity_change", "polity_end", "ruler_start", "ruler_end", "era_start", "territory_change"]}, "year": {"type": "integer", "minimum": -4000, "maximum": 2017}, "title": {"type": "string"}, "entity_id": {"type": ["string", "null"]}, "record_id": {"type": "string"}, "derived": {"const": true}, "source": {"$ref": "#/$defs/source"}}
    },
    "snapshot": {
      "type": "object", "required": ["start_year", "end_year", "path", "source_url", "vector_path"],
      "properties": {"start_year": {"type": "integer"}, "end_year": {"type": "integer"}, "path": {"type": "string"}, "source_url": {"type": "string", "format": "uri"}, "vector_path": {"type": "string"}}
    },
    "tile": {
      "type": "object", "required": ["id", "x", "y", "bbox", "in_focus", "snapshots"],
      "properties": {"id": {"type": "string", "pattern": "^[0-7][0-3]$"}, "x": {"type": "integer", "minimum": 0, "maximum": 7}, "y": {"type": "integer", "minimum": 0, "maximum": 3}, "bbox": {"$ref": "#/$defs/bbox"}, "in_focus": {"type": "boolean"}, "snapshots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/snapshot"}}}
    },
    "stitchedFeature": {
      "type": "object", "required": ["type", "id", "bbox", "geometry", "properties"],
      "properties": {
        "type": {"const": "Feature"}, "id": {"type": "string"}, "bbox": {"$ref": "#/$defs/bbox"},
        "geometry": {"type": "object", "required": ["type", "coordinates"], "properties": {"type": {"enum": ["Polygon", "MultiPolygon"]}, "coordinates": {"type": "array", "minItems": 1}}},
        "properties": {
          "type": "object", "required": ["start_year", "end_year", "source_color", "polity_id", "polity_assignment", "geometry_origin", "pixel_size_degrees", "sources"],
          "properties": {
            "start_year": {"type": "integer"}, "end_year": {"type": "integer"}, "source_color": {"type": "string", "pattern": "^#[0-9a-f]{6}$"},
            "polity_id": {"type": "null"}, "polity_assignment": {"const": "unverified"}, "geometry_origin": {"const": "raster_color_trace_stitched"}, "pixel_size_degrees": {"const": 0.1},
            "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["feature_id", "tile_id", "start_year", "end_year", "source_image", "source_url"], "properties": {"feature_id": {"type": "string"}, "tile_id": {"type": "string"}, "start_year": {"type": "integer"}, "end_year": {"type": "integer"}, "source_image": {"type": "string"}, "source_url": {"type": "string"}}}}
          }
        }
      }
    },
    "territoryFeature": {
      "type": "object", "required": ["type", "id", "bbox", "geometry", "properties"],
      "properties": {
        "type": {"const": "Feature"}, "id": {"type": "string"}, "bbox": {"$ref": "#/$defs/bbox"},
        "geometry": {"type": "object", "required": ["type", "coordinates"], "properties": {"type": {"enum": ["Polygon", "MultiPolygon"]}, "coordinates": {"type": "array", "minItems": 1}}},
        "properties": {
          "type": "object", "required": ["tile_id", "start_year", "end_year", "source_image", "source_url", "source_color", "polity_id", "polity_assignment", "geometry_origin", "pixel_size_degrees", "source_color_pixels", "simplification_degrees"],
          "properties": {"tile_id": {"type": "string"}, "start_year": {"type": "integer"}, "end_year": {"type": "integer"}, "source_image": {"type": "string"}, "source_url": {"type": "string"}, "source_color": {"type": "string", "pattern": "^#[0-9a-f]{6}$"}, "polity_id": {"type": "null"}, "polity_assignment": {"const": "unverified"}, "geometry_origin": {"const": "raster_color_trace"}, "pixel_size_degrees": {"const": 0.1}, "source_color_pixels": {"type": "integer", "minimum": 1}, "simplification_degrees": {"type": "number", "minimum": 0}}
        }
      }
    }
  }
}
